# ── Groq LLM API Configuration ─────────────────────────
# Get your API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Primary LLM Model (Required by AIVOA technical challenge specification)
MODEL_NAME=gemma2-9b-it

# Configurable Fallback Model
# NOTE: The Groq API recently decommissioned `gemma2-9b-it` (code: model_decommissioned).
# The system always attempts `MODEL_NAME` first. If decommissioned on the live Groq endpoint,
# it logs an explicit diagnostic notice and automatically falls back to `GROQ_FALLBACK_MODEL`.
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# ── PostgreSQL Database ──────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:<YOUR_PASSWORD>@localhost:5432/aivoa_qms

# SQLite fallback (optional local development)
# DATABASE_URL=sqlite:///./complaints.db

